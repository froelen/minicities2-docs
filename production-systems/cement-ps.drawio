        <mxCell id="LE56lxmc1Z3E9hd_8ZVf-38" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;left&quot;&gt;Intermediate resource transfer&lt;/div&gt;" vertex="1">
