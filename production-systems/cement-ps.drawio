        </mxCell>
        <mxCell id="LE56lxmc1Z3E9hd_8ZVf-39" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div align=&quot;left&quot;&gt;Final resource transfer&amp;nbsp;(cement)&lt;/div&gt;" vertex="1">
